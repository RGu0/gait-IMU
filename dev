#!/usr/bin/env bash
# Project command entrypoint. All governed commands (setup/test/lint/build)
# run through here; see .ai-project/project.yaml.
set -euo pipefail
cd "$(dirname "$0")"

# 与 dev.ps1 对称。POSIX 上通常已是 UTF-8 locale，设它不改变任何行为 —— 但让两个入口
# 有同一个显式前提，比让它们各自依赖平台默认好：后者正是 Windows 侧崩溃的成因。
export PYTHONUTF8=1

# 索引隔离（RAY-483）。本机若在 ~/.config/uv/uv.toml 里设了镜像（如 aliyun 且
# default = true），它会改写 uv.lock 比对时所用的索引来源，于是 `uv sync --locked`
# 报一个**假的**「lockfile 需要更新」—— 锁其实没过期，别去跑 `uv lock`。
#
# 用 UV_CONFIG_FILE 指向空设备，**不要**用 UV_NO_CONFIG=1：后者除了停用 uv.toml，
# 还会**一并停用 .python-version 的发现**，新建的 .venv 会落到最新解释器（本机
# 实测 3.14.7）上，随后 pyobjc 因无 cp314 wheel 退回 sdist，报出一条指向
# `pkg_resources` 的误导性错误。两个变量对索引的隔离效果相同，只有这一个保留 pin。
# 解法出自 techflex-cloud-foundation 的 RAY-400，已在本仓库复验。
#
# 已核：空配置文件不会遮蔽本项目 pyproject.toml 的 [tool.uv.sources] —— `uv lock
# --check` 通过，而 wt901 未发布到 PyPI，它能解析出来就证明 sources 被读到了。
# 若将来在 pyproject.toml 里新增 [tool.uv] 的其他子表，这一条要重新验。
export UV_CONFIG_FILE=/dev/null

# Node 侧与 Python 侧对称。
#
# `uv run --locked` 自己按 .python-version 解析解释器，不看调用方的 PATH，
# 所以 Python 侧无论从哪个 shell 调用跑的都是同一个版本。裸 `pnpm` 没有这个
# 性质 —— 它用 PATH 上第一个 node。本机另装的 Node 会把 .node-version 顶掉，
# 而失败出现在 preflight 里，读起来像项目坏了，其实是 shell 环境不对。
#
# fnm exec 是 Node 侧的等价物。判定写得比"有 fnm 就用 fnm"更严：只有当 fnm
# 解析出的版本确实等于 .node-version 时才走它。fnm 装了但没装这个版本、或解析
# 出别的版本，都回退到 PATH —— 此时版本正确性由 preflight 单独守门，所以回退
# 路径是被守住的，而不是无人负责的。不引入 fnm 硬依赖。
node_via_fnm=no
if command -v fnm >/dev/null 2>&1; then
  if [ "$(fnm exec -- node --version 2>/dev/null)" = "v$(cat .node-version)" ]; then
    node_via_fnm=yes
  fi
fi

# 用函数而不是 ${runner[@]}：macOS 自带 bash 3.2，空数组在 set -u 下展开即报错。
run_node() {
  if [ "$node_via_fnm" = yes ]; then
    fnm exec -- "$@"
  else
    "$@"
  fi
}

cmd="${1:-}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
  setup)
    uv sync --locked
    run_node pnpm install --frozen-lockfile
    ;;
  test)
    uv run --locked python -m pytest "$@"
    run_node pnpm run test
    ;;
  lint)
    # ruff 与四条项目红线合并进**一次** uv run（RAY-467）。此前是五次，而 `--locked`
    # 让 uv 每次调用都重新解析依赖 —— 其中的 GitHub release 资产每次都要 revalidate
    # 一轮，实测五次合计 18.87 s，占 ./dev lint 总时长的 92%，而真实工作量是 0.12 s。
    #
    # `--locked` 一点没放弃：锁文件新鲜度仍然每次都验，只是验一遍而不是五遍。
    # 逐条检查各自守什么、以及「五项全跑完再报齐」这个与旧行为的差异，见该脚本的文档。
    # "$@" 只透传给 ruff，与合并前一致。
    uv run --locked python tools/run_lint_checks.py "$@"
    run_node pnpm run lint
    ;;
  build)
    uv build "$@"
    run_node pnpm run build
    ;;
  node)
    # 逃生舱：在本入口解析出的 Node 环境里跑任意命令，供排查用。
    # 例：./dev node node --version / ./dev node pnpm why foo
    run_node "$@"
    ;;
  *)
    echo "usage: ./dev {setup|test|lint|build|node <cmd>...}" >&2
    exit 2
    ;;
esac
